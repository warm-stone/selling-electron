{
  "name": "selling-electron",
  "version": "0.3.0",
  "description": "Windows 桌面销存系统（POS）— Electron + Vue 3 + TypeScript",
  "author": "selling-electron",
  "repository": {
    "type": "git",
    "url": "github:warm-stone/selling-electron"
  },
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vue/test-utils": "^2.5.1",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.15.1",
    "element-plus": "^2.14.7",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "node-thermal-printer": "^4.6.1",
    "pinia": "^4.1.0",
    "pngjs": "^7.0.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
